# ═══════════════════════════════════════════════════════════════════════
#  Compteur Ciment — Variables d'environnement
#  Copier ce fichier vers .env et adapter les valeurs
# ═══════════════════════════════════════════════════════════════════════

# ── Base de données ─────────────────────────────────────────────────────────
# SQLite (défaut) : sqlite:////data/cement_counter.db
# PostgreSQL      : postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:////data/cement_counter.db

# ── Sécurité JWT ────────────────────────────────────────────────────────────
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
# OBLIGATOIRE — générer avec : python -c "import secrets; print(secrets.token_hex(32))"
# Le serveur refusera de démarrer si cette variable est absente ou vide.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Vision / YOLO ───────────────────────────────────────────────────────────
# Activer ou désactiver le moteur de détection
VISION_ENABLED=true
# Chemin vers le modèle YOLO (relatif à /app dans le conteneur)
YOLO_MODEL_PATH=models/best.pt
# Indice de la caméra (0 = première caméra USB/intégrée)
CAMERA_INDEX=0

# ── Admin par défaut ────────────────────────────────────────────────────────
# Utilisé uniquement à la première initialisation si aucun admin n'existe.
# OBLIGATOIRE — le serveur refuse de démarrer si le mot de passe est absent
# ou trop faible (admin, admin1234, password, 123456, changeme).
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# ── CORS ────────────────────────────────────────────────────────────────────
# Origines autorisées (séparées par des virgules)
# En production, remplacer par le domaine réel : https://mon-domaine.com
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:80

# ── Logs ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
